{
  "environments": [
    {
      "name": "conduct",
      "paths": [
        "conduct"
      ],
      "checks": {
        ".md": [
          {
            "name": "conduct",
            "command": "node",
            "args": [
              "conduct/resources/scripts/validate-documents.mjs",
              "--file",
              "$FILE",
              "--json"
            ],
            "parser": "jsonl",
            "_conduct": true
          }
        ]
      },
      "_conduct": true
    },
    {
      "name": "codanna-settings",
      "paths": [
        ".codanna"
      ],
      "checks": {
        ".toml": [
          {
            "name": "codanna-settings",
            "command": "node",
            "args": [
              "conduct/resources/scripts/check-codanna-settings.mjs",
              "--file",
              "$FILE",
              "--json"
            ],
            "parser": "jsonl",
            "_conduct": true
          }
        ]
      },
      "_conduct": true
    },
    {
      "name": "tests",
      "paths": [
        "tests"
      ],
      "checks": {
        ".ts": [
          {
            "name": "oxfmt",
            "command": "node",
            "args": [
              "node_modules/oxfmt/bin/oxfmt",
              "--check",
              "$FILE"
            ],
            "parser": "prettier",
            "_auto": true
          },
          {
            "name": "oxlint",
            "command": "node",
            "args": [
              "node_modules/oxlint/bin/oxlint",
              "--config",
              ".oxlintrc.json",
              "--format=unix",
              "--deny-warnings",
              "$FILE"
            ],
            "parser": "oxlint",
            "_auto": true
          },
          {
            "name": "tsc-files",
            "command": "node",
            "args": [
              "node_modules/tsc-files/cli.js",
              "--noEmit",
              "-p",
              "tsconfig.test.json",
              "$FILE"
            ],
            "parser": "tsc",
            "_auto": true
          }
        ]
      }
    },
    {
      "name": "src",
      "paths": [
        "src"
      ],
      "checks": {
        ".ts": [
          {
            "name": "oxfmt",
            "command": "node",
            "args": [
              "node_modules/oxfmt/bin/oxfmt",
              "--check",
              "$FILE"
            ],
            "parser": "prettier",
            "_auto": true
          },
          {
            "name": "oxlint",
            "command": "node",
            "args": [
              "node_modules/oxlint/bin/oxlint",
              "--config",
              ".oxlintrc.json",
              "--format=unix",
              "--deny-warnings",
              "$FILE"
            ],
            "parser": "oxlint",
            "_auto": true
          },
          {
            "name": "tsc-files",
            "command": "node",
            "args": [
              "node_modules/tsc-files/cli.js",
              "--noEmit",
              "$FILE"
            ],
            "parser": "tsc",
            "_auto": true
          }
        ]
      }
    },
    {
      "name": "root",
      "paths": [
        "."
      ],
      "exclude": [
        "dist/**",
        "src/**",
        "tests/**"
      ],
      "checks": {
        ".json,.mjs": [
          {
            "name": "oxfmt",
            "command": "node",
            "args": [
              "node_modules/oxfmt/bin/oxfmt",
              "--check",
              "$FILE"
            ],
            "parser": "prettier",
            "_auto": true
          }
        ]
      }
    }
  ],
  "tasks": [
    {
      "name": "policy-reviewer",
      "match": "conduct:policy-engineer",
      "action": "review",
      "message": "Invoke conduct:policy-reviewer to validate the policy file.",
      "_conduct": true
    },
    {
      "name": "mcp-code-reviewer",
      "match": "mcp-engineer",
      "action": "review",
      "message": "Invoke mcp-code-reviewer to validate the implementation.",
      "_conduct": true
    },
    {
      "name": "cli-code-reviewer",
      "match": "cli-engineer",
      "action": "review",
      "message": "Invoke cli-code-reviewer to validate the implementation.",
      "_conduct": true
    },
    {
      "name": "library-code-reviewer",
      "match": "library-engineer",
      "action": "review",
      "message": "Invoke library-code-reviewer to validate the implementation.",
      "_conduct": true
    }
  ]
}
