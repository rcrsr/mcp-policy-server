{
  "name": "@rcrsr/mcp-policy-server",
  "version": "0.6.4",
  "description": "MCP server providing token-efficient access to policy documentation via § notation",
  "main": "dist/index.js",
  "bin": {
    "@rcrsr/mcp-policy-server": "dist/index.js",
    "mcp-policy-server": "dist/index.js",
    "policy-hook": "dist/hook.js",
    "policy-fetch": "dist/hook.js",
    "policy-cli": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/mcp-policy-server.git"
  },
  "bugs": {
    "url": "https://github.com/rcrsr/mcp-policy-server/issues"
  },
  "homepage": "https://github.com/rcrsr/mcp-policy-server#readme",
  "scripts": {
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist coverage",
    "lint": "oxlint --config .oxlintrc.json src/ tests/",
    "lint:fix": "oxlint --config .oxlintrc.json --fix src/ tests/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "pre-commit": "npm run format:check && npm run lint && npm run typecheck",
    "pre-commit:fix": "npm run format && npm run lint:fix && npm run typecheck",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "policy",
    "standards",
    "guidelines",
    "ai-agents",
    "claude"
  ],
  "license": "GPL-3.0-or-later",
  "author": "André Bremer",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "docs/**/*"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "rimraf": "^6.1.3",
    "tsc-files": "^1.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
