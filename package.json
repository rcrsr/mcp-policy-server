{
  "name": "@rcrsr/mcp-policy-server",
  "version": "0.7.0",
  "description": "MCP server providing token-efficient access to policy documentation via § notation",
  "main": "dist/index.js",
  "bin": {
    "@rcrsr/mcp-policy-server": "dist/index.js",
    "mcp-policy-server": "dist/index.js",
    "policy-hook": "dist/hook.js",
    "policy-fetch": "dist/hook.js",
    "policy-cli": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcrsr/mcp-policy-server.git"
  },
  "bugs": {
    "url": "https://github.com/rcrsr/mcp-policy-server/issues"
  },
  "homepage": "https://github.com/rcrsr/mcp-policy-server#readme",
  "scripts": {
    "prepare": "lefthook install --force",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist coverage",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "check": "npm run check:types && npm run check:lint && npm run check:format && npm run test:coverage && npm run check:deps",
    "check:types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check:lint": "oxlint --config .oxlintrc.json src/ tests/",
    "check:format": "oxfmt --check",
    "check:deps": "knip",
    "fix:lint": "oxlint --config .oxlintrc.json --fix src/ tests/",
    "fix:format": "oxfmt",
    "prepublishOnly": "npm run clean && npm run check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "policy",
    "standards",
    "guidelines",
    "ai-agents",
    "claude"
  ],
  "license": "GPL-3.0-or-later",
  "author": "André Bremer",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "docs/**/*"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "knip": "^6.34.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "rimraf": "^6.1.3",
    "tsc-files": "^1.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
